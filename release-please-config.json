{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "rust",
      "package-name": "agent-hub",
      "changelog-path": "CHANGELOG.md",
      "versioning": "always-bump-minor",
      "extra-files": [
        {
          "type": "json",
          "path": "plugins/claude/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": ".claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].version"
        },
        {
          "type": "json",
          "path": "plugins/opencode/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "plugins/antigravity/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "plugins/launcher/agent-hub-launcher"
        },
        {
          "type": "generic",
          "path": "plugins/claude/bin/agent-hub-launcher"
        },
        {
          "type": "generic",
          "path": "plugins/antigravity/bin/agent-hub-launcher"
        }
      ]
    }
  }
}
