# Agent scratch area: working notes, drafts, inbox, task breakdowns.
# Never committed.
/.agents/brain/

# Local assistant state and tool shims. The one contract is AGENTS.md; every
# shim points at it, and .agents/bootstrap.sh writes them. Never committed.
/.claude/
/.gemini/
/.antigravity/
/.cursor/
/.opencode/
/.pi/
/.codex/
/.windsurf/
/.continue/
/.aider*
/CLAUDE.md
/GEMINI.md
/ANTIGRAVITY.md
/CURSOR.md
/PI.md
/.cursorrules
/.windsurfrules

# Worktrees
/.worktrees/

# Rust build output
/target/

# Local hub data volume
/data/

# Local environment
.env
.env.local

# Python bytecode from the check scripts
__pycache__/

# Editor and OS
*.swp
*~
.DS_Store

# Node toolchain for the PWA. The lockfile is committed; the tree is not.
/node_modules/

# Site build output and the docs renderer it downloads
/site/build/
/site/dist/
/site/.toolchain/
/site/.toolchain-work/
/site/node_modules/
/site/.wrangler/

# Android app build output and local config
/android/.gradle/
/android/.kotlin/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/
*.keystore
*.p12
keystore.properties
