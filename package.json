{
  "name": "agent-hub",
  "private": true,
  "version": "0.0.0",
  "description": "Development toolchain for the PWA. Nothing here ships: the client is served as vanilla ES modules, with no bundler and no runtime dependency.",
  "type": "module",
  "scripts": {
    "units": "vitest run",
    "styles": "vitest run .agents/js-tests/styles.test.mjs",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/cantarell": "5.3.0",
    "@fontsource/dejavu-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "css-tree": "3.2.1",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
