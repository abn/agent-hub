{
  "name": "credential-url-normalisation-project-and-client",
  "input": {
    "env": {},
    "pinned_url": null,
    "project_file": {
      "url": "http://Hub.Example.net:80/",
      "member": "laptop"
    },
    "project_root": "/work/repo",
    "config": {
      "client": {
        "url": "http://hub.example.net"
      },
      "credentials": [
        {
          "url": "http://hub.example.net",
          "member": "laptop",
          "token": "t-1"
        }
      ],
      "trust": {
        "pairings": [
          {
            "path": "/work/repo",
            "url": "http://hub.example.net",
            "member": "laptop"
          }
        ]
      }
    }
  },
  "expect": {
    "url": "http://hub.example.net",
    "member": "laptop",
    "token": "t-1",
    "source": {
      "url": "project",
      "member": "project",
      "token": "credential"
    },
    "state": "ok"
  }
}
